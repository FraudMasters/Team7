# ==============================================
# Backend Production Environment Variables Template
# ==============================================
# Copy this file to .env.production and update with your values
# This template is for the production environment

# ==============================================
# Environment Configuration
# ==============================================
# Current environment: development, staging, production
ENVIRONMENT=production

# ==============================================
# Database Configuration
# ==============================================
# PostgreSQL database connection URL
# Format: postgresql://user:password@host:port/database
# IMPORTANT: Use strong passwords and SSL in production
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@production-db.example.com:5432/resume_analysis

# ==============================================
# Redis Configuration
# ==============================================
# Redis connection URL for caching and Celery
# IMPORTANT: Use Redis authentication in production
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@production-redis.example.com:6379/0

# ==============================================
# Backend Server Configuration
# ==============================================
# Host to bind the FastAPI server
BACKEND_HOST=0.0.0.0

# Port to bind the FastAPI server
BACKEND_PORT=8000

# ==============================================
# Frontend Configuration (CORS)
# ==============================================
# Frontend URL for CORS configuration
# IMPORTANT: Use HTTPS in production
FRONTEND_URL=https://app.example.com

# ==============================================
# ML Models Configuration
# ==============================================
# Path to cache ML models (relative or absolute)
MODELS_CACHE_PATH=/var/lib/resume-analysis/models_cache

# ==============================================
# LanguageTool Server Configuration
# ==============================================
# LanguageTool server URL for grammar checking (optional)
# LANGUAGETOOL_SERVER=https://languagetool.example.com

# ==============================================
# File Upload Configuration
# ==============================================
# Maximum file upload size in megabytes (1-100)
MAX_UPLOAD_SIZE_MB=10

# Allowed file extensions for upload (comma-separated)
ALLOWED_FILE_TYPES=.pdf,.docx

# ==============================================
# Analysis Configuration
# ==============================================
# Maximum time for resume analysis in seconds (30-600)
ANALYSIS_TIMEOUT_SECONDS=300

# ==============================================
# Logging Configuration
# ==============================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# IMPORTANT: Use WARNING or ERROR in production to reduce log volume
LOG_LEVEL=WARNING

# ==============================================
# Celery Configuration
# ==============================================
# Celery broker URL (typically same as Redis URL)
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@production-redis.example.com:6379/0

# Celery result backend URL (typically same as Redis URL)
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@production-redis.example.com:6379/0

# ==============================================
# Backup Configuration
# ==============================================
# Enable automated backups
# IMPORTANT: Always enable backups in production
BACKUP_ENABLED=true

# Default backup retention period in days (1-365)
BACKUP_RETENTION_DAYS=30

# Cron expression for scheduled backups (default: daily at 2 AM)
BACKUP_SCHEDULE=0 2 * * *

# Directory for storing backup files
# IMPORTANT: Use absolute path in production
BACKUP_DIR=/var/lib/resume-analysis/backups

# Enable S3 off-site backup
# IMPORTANT: Enable S3 backups for disaster recovery
BACKUP_S3_ENABLED=true

# S3 bucket name for backups
BACKUP_S3_BUCKET=production-backups-example-com

# S3-compatible endpoint URL
BACKEND_S3_ENDPOINT=https://s3.amazonaws.com

# S3 access key ID
BACKEND_S3_ACCESS_KEY=CHANGE_ME_AWS_ACCESS_KEY

# S3 secret access key
BACKEND_S3_SECRET_KEY=CHANGE_ME_AWS_SECRET_KEY

# S3 region
BACKUP_S3_REGION=us-east-1

# Email for backup failure notifications
BACKUP_NOTIFICATION_EMAIL=ops@example.com

# Enable incremental backups
BACKUP_INCREMENTAL_ENABLED=true

# Enable backup compression
BACKUP_COMPRESSION_ENABLED=true

# ==============================================
# Audit Log Configuration
# ==============================================
# Default audit log retention period in days (1-365)
# IMPORTANT: Keep audit logs for compliance (typically 90 days)
AUDIT_LOG_RETENTION_DAYS=90

# ==============================================
# LLM API Configuration for ATS Simulation
# ==============================================
# LLM provider: openai, anthropic, google, zai
LLM_PROVIDER=zai

# Z.ai API key for ATS simulation
# IMPORTANT: Use production API keys with appropriate rate limits
ZAI_API_KEY=CHANGE_ME_ZAI_PRODUCTION_KEY

# Z.ai API base URL
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# OpenAI API key (if using OpenAI as provider)
# OPENAI_API_KEY=CHANGE_ME_OPENAI_PRODUCTION_KEY

# Anthropic API key (if using Anthropic as provider)
# ANTHROPIC_API_KEY=CHANGE_ME_ANTHROPIC_PRODUCTION_KEY

# Google API key (if using Google as provider)
# GOOGLE_API_KEY=CHANGE_ME_GOOGLE_PRODUCTION_KEY

# Default LLM model for ATS simulation
LLM_MODEL=glm-4.7

# Temperature for LLM calls (0.0-1.0, lower = more deterministic)
LLM_TEMPERATURE=0.1

# Maximum tokens for LLM responses (256-32768)
LLM_MAX_TOKENS=4096

# ==============================================
# ATS Simulation Configuration
# ==============================================
# Minimum ATS score to pass (0.0-1.0)
ATS_THRESHOLD=0.6

# Enable visual format checking in ATS
ATS_VISUAL_CHECK_ENABLED=true

# Weight for keyword matching in ATS score (0.0-1.0)
ATS_KEYWORD_WEIGHT=0.3

# Weight for experience matching in ATS score (0.0-1.0)
ATS_EXPERIENCE_WEIGHT=0.3

# Weight for education matching in ATS score (0.0-1.0)
ATS_EDUCATION_WEIGHT=0.2

# Weight for overall fit assessment in ATS score (0.0-1.0)
ATS_FIT_WEIGHT=0.2

# ==============================================
# Security Notes
# ==============================================
# 1. Copy this file to .env.production and update with STRONG passwords
# 2. NEVER commit .env.production to version control (it contains sensitive data)
# 3. Only commit .env.production.example as a template
# 4. Use different passwords for each service (database, Redis, S3, API keys)
# 5. Use secrets management tools (AWS Secrets Manager, HashiCorp Vault, etc.)
# 6. Enable SSL/TLS for all connections (database, Redis, etc.)
# 7. Rotate credentials regularly (at least every 90 days)
# 8. Monitor for unauthorized access attempts
# 9. Use least privilege principle for database users
# 10. Enable firewall rules to restrict database access
# 11. Test all configuration values in staging before production deployment
# 12. Have a backup and restoration plan tested and ready
