# Backend API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=120000
VITE_API_RETRY_ENABLED=true

# ==============================================
# Authentication Configuration
# ==============================================
# Enable/disable authentication system
# Set to 'false' for development (bypasses all auth checks)
# Set to 'true' for production (requires authentication)
VITE_AUTH_ENABLED=false

# Mock role to use when auth is disabled
# Options: 'Admin', 'Recruiter', 'JobSeeker'
VITE_MOCK_ROLE=Admin

# Enable debug logging for auth/routing
VITE_AUTH_DEBUG=false

# ==============================================
# OIDC Configuration (Future)
# ==============================================
# KeyCloak OIDC settings (when AUTH_ENABLED=true)
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/agenthr
VITE_OIDC_CLIENT_ID=agenthr-frontend
VITE_OIDC_ENABLED=false

# ==============================================
# Feature Flags
# ==============================================
VITE_ENABLE_ADMIN_FEATURES=true
VITE_ENABLE_ERROR_BOUNDARIES=true
VITE_ENABLE_SERVICE_DEGRADATION=true
VITE_ENABLE_NAVIGATION_FAILURE_HANDLING=true
VITE_ENABLE_ROUTE_PROTECTION=true
