# Backend API Configuration
# API Gateway URL - routes to microservices (Resume:8001, Matching:8002, etc.)
VITE_API_URL=http://localhost:5888
VITE_API_TIMEOUT=120000
VITE_API_RETRY_ENABLED=true

# OIDC/Keycloak Configuration
# Keycloak URL for authentication (port 5881 to avoid conflicts)
VITE_OIDC_AUTHORITY=http://localhost:5881/realms/agenthr
# OIDC Client ID
VITE_OIDC_CLIENT_ID=agenthr-frontend
