# ==============================================
# Backend Production Environment Variables
# ==============================================
# This file contains actual configuration for the production environment
# DO NOT commit this file to version control
# IMPORTANT: Use strong passwords and SSL in production

# ==============================================
# Environment Configuration
# ==============================================
ENVIRONMENT=production

# ==============================================
# Database Configuration
# ==============================================
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_PASSWORD@production-db.example.com:5432/resume_analysis

# ==============================================
# Redis Configuration
# ==============================================
REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@production-redis.example.com:6379/0

# ==============================================
# Backend Server Configuration
# ==============================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# ==============================================
# Frontend Configuration (CORS)
# ==============================================
FRONTEND_URL=https://app.example.com

# ==============================================
# ML Models Configuration
# ==============================================
MODELS_CACHE_PATH=/var/lib/resume-analysis/models_cache

# ==============================================
# LanguageTool Server Configuration
# ==============================================
# LANGUAGETOOL_SERVER=https://languagetool.example.com

# ==============================================
# File Upload Configuration
# ==============================================
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=.pdf,.docx

# ==============================================
# Analysis Configuration
# ==============================================
ANALYSIS_TIMEOUT_SECONDS=300

# ==============================================
# Logging Configuration
# ==============================================
LOG_LEVEL=WARNING

# ==============================================
# Celery Configuration
# ==============================================
CELERY_BROKER_URL=redis://:CHANGE_ME_REDIS_PASSWORD@production-redis.example.com:6379/0
CELERY_RESULT_BACKEND=redis://:CHANGE_ME_REDIS_PASSWORD@production-redis.example.com:6379/0

# ==============================================
# Backup Configuration
# ==============================================
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
BACKUP_DIR=/var/lib/resume-analysis/backups
BACKUP_S3_ENABLED=true
BACKUP_S3_BUCKET=production-backups-example-com
BACKEND_S3_ENDPOINT=https://s3.amazonaws.com
BACKEND_S3_ACCESS_KEY=CHANGE_ME_AWS_ACCESS_KEY
BACKEND_S3_SECRET_KEY=CHANGE_ME_AWS_SECRET_KEY
BACKUP_S3_REGION=us-east-1
BACKUP_NOTIFICATION_EMAIL=ops@example.com
BACKUP_INCREMENTAL_ENABLED=true
BACKUP_COMPRESSION_ENABLED=true

# ==============================================
# Audit Log Configuration
# ==============================================
AUDIT_LOG_RETENTION_DAYS=90

# ==============================================
# LLM API Configuration for ATS Simulation
# ==============================================
LLM_PROVIDER=zai
ZAI_API_KEY=CHANGE_ME_ZAI_PRODUCTION_KEY
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.7
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ==============================================
# ATS Simulation Configuration
# ==============================================
ATS_THRESHOLD=0.6
ATS_VISUAL_CHECK_ENABLED=true
ATS_KEYWORD_WEIGHT=0.3
ATS_EXPERIENCE_WEIGHT=0.3
ATS_EDUCATION_WEIGHT=0.2
ATS_FIT_WEIGHT=0.2
