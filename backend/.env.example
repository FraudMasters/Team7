# ==============================================
# Backend Environment Variables Template
# ==============================================
# Copy this file to .env and update with your values

# ==============================================
# Database Configuration
# ==============================================
# ⚠️ SECURITY: PostgreSQL connection URL contains credentials
# Format: postgresql://user:password@host:port/database
# PRODUCTION: Use strong password (16+ chars, mixed case, numbers, symbols)
# PRODUCTION: Restrict database user to minimum required permissions
# See docs/ENVIRONMENT_VARIABLES.md#database for more details
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analysis

# Alternative: Separate database configuration (used by docker-compose)
# ⚠️ SECURITY: POSTGRES_PASSWORD must be strong in production
# See docs/ENVIRONMENT_VARIABLES.md#database for more details
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=postgres
# POSTGRES_DB=resume_analysis
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# ==============================================
# Redis Configuration (for Celery broker and result backend)
# ==============================================
# Redis connection URL (format: redis://host:port/database)
# See docs/ENVIRONMENT_VARIABLES.md#redis for more details
REDIS_URL=redis://localhost:6379/0

# Celery broker URL (typically same as Redis URL)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend (where task results are stored)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================
# Backend API Configuration
# ==============================================
# Host and port for the FastAPI server
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# API title and version (for OpenAPI documentation)
API_TITLE=Resume Analysis API
API_VERSION=1.0.0

# ==============================================
# CORS (Cross-Origin Resource Sharing) Settings
# ==============================================
# Frontend URL to allow CORS requests from (comma-separated for multiple)
# See docs/ENVIRONMENT_VARIABLES.md#cors for more details
FRONTEND_URL=http://localhost:5173

# CORS allowed origins (comma-separated, use * for all - not recommended for production)
# See docs/ENVIRONMENT_VARIABLES.md#cors for more details
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ==============================================
# File Upload Configuration
# ==============================================
# Maximum file upload size in megabytes
# See docs/ENVIRONMENT_VARIABLES.md#file-upload for more details
MAX_UPLOAD_SIZE_MB=10

# Allowed file extensions (comma-separated)
# See docs/ENVIRONMENT_VARIABLES.md#file-upload for more details
ALLOWED_FILE_TYPES=.pdf,.docx

# Upload directory for temporary file storage
UPLOAD_DIR=./uploads

# ==============================================
# ML Models Configuration
# ==============================================
# Path to cache ML models (downloaded models stored here)
# See docs/ENVIRONMENT_VARIABLES.md#ml-models for more details
MODELS_CACHE_PATH=./models_cache

# KeyBERT model name (default: distilbert-base-nli-mean-tokens)
# Alternative models: sentence-transformers/all-MiniLM-L6-v2
# PERFORMANCE IMPACT:
#   - distilbert-base-nli-mean-tokens: ~250MB, moderate CPU/memory usage, good accuracy
#   - all-MiniLM-L6-v2: ~80MB, lower CPU/memory usage, faster inference, slightly less accuracy
#   - Larger models (bert-base-nli-mean-tokens): ~400MB+, higher CPU/memory, better accuracy
# RECOMMENDATION: Start with distilbert-base, switch to MiniLM if memory constrained
# See docs/ENVIRONMENT_VARIABLES.md#ml-models for more details
KEYBERT_MODEL=distilbert-base-nli-mean-tokens

# SpaCy language models (will be downloaded if not present)
# PERFORMANCE IMPACT:
#   - en_core_web_sm: ~12MB, fast inference, optimized for production
#   - en_core_web_md: ~40MB, better accuracy, moderate CPU/memory
#   - en_core_web_lg: ~500MB, best accuracy, high CPU/memory, slower
# RECOMMENDATION: Use _sm models for production, _md/_lg for batch processing
# See docs/ENVIRONMENT_VARIABLES.md#ml-models for more details
SPACY_MODEL_EN=en_core_web_sm
SPACY_MODEL_RU=ru_core_web_sm

# Sentence Transformers model for resume-vacancy matching
# PERFORMANCE IMPACT:
#   - all-MiniLM-L6-v2: ~80MB, very fast, low memory, good for real-time
#   - all-mpnet-base-v2: ~400MB, slower, high memory, best accuracy
#   - multi-qa-mpnet-base-dot-v1: ~400MB, optimized for similarity tasks
# RECOMMENDATION: MiniLM for real-time API, mpnet for batch processing
# See docs/ENVIRONMENT_VARIABLES.md#ml-models for more details
SENTENCE_TRANSFORMER_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ==============================================
# LanguageTool Configuration (Grammar/Spelling Checking)
# ==============================================
# LanguageTool server URL (local or public)
# Local server: http://localhost:8081/v2/check
# Public server: https://api.languagetool.org/v2/check
LANGUAGETOOL_SERVER=http://localhost:8081/v2/check

# Fallback to public API if local server fails
LANGUAGETOOL_USE_PUBLIC_AS_FALLBACK=true

# ==============================================
# Celery Worker Configuration
# ==============================================
# Celery worker concurrency (number of parallel tasks)
# See docs/ENVIRONMENT_VARIABLES.md#celery for more details
CELERY_WORKER_CONCURRENCY=2

# Celery worker log level
# See docs/ENVIRONMENT_VARIABLES.md#celery for more details
CELERY_LOG_LEVEL=info

# Task time limit in seconds (prevents hanging tasks)
CELERY_TASK_TIME_LIMIT=300

# Task soft time limit (allows graceful shutdown)
CELERY_TASK_SOFT_TIME_LIMIT=280

# Maximum number of task retries
CELERY_TASK_MAX_RETRIES=3

# Task result expiration time (seconds)
CELERY_RESULT_EXPIRES=86400

# ==============================================
# Analysis Configuration
# ==============================================
# Maximum analysis time in seconds (prevents long-running analyses)
# See docs/ENVIRONMENT_VARIABLES.md#analysis for more details
ANALYSIS_TIMEOUT_SECONDS=300

# Enable/disable specific analysis components
# See docs/ENVIRONMENT_VARIABLES.md#analysis for more details
ENABLE_KEYWORD_EXTRACTION=true
ENABLE_NER_EXTRACTION=true
ENABLE_GRAMMAR_CHECK=true
ENABLE_EXPERIENCE_CALCULATION=true
ENABLE_ERROR_DETECTION=true

# Keyword extraction parameters
KEYWORD_EXTRACTION_TOP_N=20
KEYWORD_NGRAM_RANGE_MIN=1
KEYWORD_NGRAM_RANGE_MAX=2

# Experience calculation parameters
EXPERIENCE_OVERLAP_DETECTION=true

# ==============================================
# Error Detection Configuration
# ==============================================
# Resume length limits (characters)
RESUME_MIN_LENGTH=500
RESUME_MAX_LENGTH=10000

# Portfolio requirement threshold (years of experience)
PORTFOTALIO_EXPERIENCE_THRESHOLD=1

# ==============================================
# Security Configuration
# ==============================================
# ⚠️ CRITICAL SECURITY: Secret key for JWT tokens
# Generate with: openssl rand -hex 32
# PRODUCTION: MUST be changed! Use a cryptographically secure random key (64+ hex chars)
# PRODUCTION: Never share this key or commit it to version control
# PRODUCTION: Rotate this key periodically (recommend every 90 days)
# LEAK IMPACT: If leaked, attackers can forge JWT tokens and access any account
# See docs/ENVIRONMENT_VARIABLES.md#security for more details
SECRET_KEY=your-secret-key-here-change-in-production

# JWT algorithm (HS256, RS256, etc.)
# ⚠️ SECURITY: Use RS256 with asymmetric keys in production for better security
# See docs/ENVIRONMENT_VARIABLES.md#security for more details
JWT_ALGORITHM=HS256

# JWT token expiration time (minutes)
# PRODUCTION: Shorter values are more secure (30 minutes or less recommended)
# Consider implementing refresh token rotation for better UX
# See docs/ENVIRONMENT_VARIABLES.md#security for more details
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# API rate limiting (requests per minute)
# PRODUCTION: Adjust based on your traffic patterns and DDoS protection needs
# See docs/ENVIRONMENT_VARIABLES.md#security for more details
RATE_LIMIT_PER_MINUTE=60

# ==============================================
# Logging Configuration
# ==============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
# See docs/ENVIRONMENT_VARIABLES.md#logging for more details
LOG_LEVEL=INFO

# Log format: json, text
# See docs/ENVIRONMENT_VARIABLES.md#logging for more details
LOG_FORMAT=json

# Log file path (leave empty to log to stdout)
# See docs/ENVIRONMENT_VARIABLES.md#logging for more details
LOG_FILE=

# ==============================================
# LLM API Configuration for ATS Simulation
# ==============================================
# LLM provider to use (zai, openai, anthropic, google)
# See docs/ENVIRONMENT_VARIABLES.md#llm for more details
LLM_PROVIDER=zai

# ⚠️ SECURITY: Z.ai API Key
# PRODUCTION: Keep secret, monitor usage for unusual activity
# PRODUCTION: Set up spending limits to prevent unexpected charges
# Get your key at: https://platform.z.ai
# See docs/ENVIRONMENT_VARIABLES.md#llm for more details
ZAI_API_KEY=your-zai-api-key-here

# Z.ai API base URL
# See docs/ENVIRONMENT_VARIABLES.md#llm for more details
ZAI_BASE_URL=https://api.z.ai/v1

# ⚠️ SECURITY: OpenAI API Key
# PRODUCTION: Keep secret, monitor usage for unusual activity
# PRODUCTION: Set up spending limits to prevent unexpected charges
# Get your key at: https://platform.openai.com/api-keys
# See docs/ENVIRONMENT_VARIABLES.md#llm for more details
OPENAI_API_KEY=sk-your-openai-key-here

# ⚠️ SECURITY: Anthropic API Key
# PRODUCTION: Keep secret, monitor usage for unusual activity
# PRODUCTION: Set up spending limits to prevent unexpected charges
# Get your key at: https://console.anthropic.com
# See docs/ENVIRONMENT_VARIABLES.md#llm for more details
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ⚠️ SECURITY: Google API Key
# PRODUCTION: Keep secret, restrict key to only required APIs
# PRODUCTION: Set up quotas and monitor usage
# Get your key at: https://console.cloud.google.com
# See docs/ENVIRONMENT_VARIABLES.md#llm for more details
GOOGLE_API_KEY=your-google-api-key-here

# Default model to use (e.g., claude-3-5-sonnet-20241022, gpt-4o-mini, gemini-1.5-flash)
# See docs/ENVIRONMENT_VARIABLES.md#llm for more details
LLM_MODEL=claude-3-5-sonnet-20241022

# LLM temperature (0.0-1.0, lower = more deterministic)
# See docs/ENVIRONMENT_VARIABLES.md#llm for more details
LLM_TEMPERATURE=0.1

# Maximum tokens for LLM responses
# See docs/ENVIRONMENT_VARIABLES.md#llm for more details
LLM_MAX_TOKENS=4096

# ==============================================
# ATS Simulation Configuration
# ==============================================
# Minimum ATS score to pass (0.0-1.0)
# See docs/ENVIRONMENT_VARIABLES.md#ats for more details
ATS_THRESHOLD=0.6

# Enable visual format checking in ATS
# See docs/ENVIRONMENT_VARIABLES.md#ats for more details
ATS_VISUAL_CHECK_ENABLED=true

# ATS score weights (should sum to ~1.0)
# See docs/ENVIRONMENT_VARIABLES.md#ats for more details
ATS_KEYWORD_WEIGHT=0.3
ATS_EXPERIENCE_WEIGHT=0.3
ATS_EDUCATION_WEIGHT=0.2
ATS_FIT_WEIGHT=0.2

# ==============================================
# Optional: External Services
# ==============================================
# ⚠️ SECURITY: AWS S3 credentials for file storage
# PRODUCTION: Use IAM roles instead of access keys when possible
# PRODUCTION: Restrict IAM user to only this specific S3 bucket
# PRODUCTION: Enable MFA on the AWS account
# PRODUCTION: Rotate access keys regularly (every 90 days)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key
# AWS_REGION=us-east-1
# AWS_S3_BUCKET=resume-analysis-files

# ⚠️ SECURITY: SendGrid API Key for email notifications
# PRODUCTION: Restrict key to only send emails, not manage account
# PRODUCTION: Monitor sending volume for unusual activity
# Get your key at: https://app.sendgrid.com/settings/api_keys
# SENDGRID_API_KEY=your-sendgrid-key

# ⚠️ SECURITY: Sentry DSN for error tracking
# PRODUCTION: The DSN can leak information about your tech stack
# PRODUCTION: Configure Sentry to filter sensitive data (passwords, tokens, etc.)
# Get your DSN at: https://sentry.io/settings/projects/
# SENTRY_DSN=https://your-sentry-dsn

# ==============================================
# Development/Testing Settings
# ==============================================
# Debug mode (enable only in development)
# See docs/ENVIRONMENT_VARIABLES.md#development for more details
DEBUG=false

# Reload server on file changes (development only)
# See docs/ENVIRONMENT_VARIABLES.md#development for more details
RELOAD=false

# Test mode (enables test-specific features)
# See docs/ENVIRONMENT_VARIABLES.md#development for more details
TESTING=false

# ==============================================
# Monitoring & Analytics
# ==============================================
# Enable Prometheus metrics
ENABLE_PROMETHEUS_METRICS=false

# Prometheus metrics port
PROMETHEUS_PORT=9090

# Google Analytics tracking ID
# GA_TRACKING_ID=UA-XXXXXXXXX-X

# ==============================================
# Feature Flags
# ==============================================
# Enable experimental features
ENABLE_EXPERIMENTAL_FEATURES=false

# Enable beta features
ENABLE_BETA_FEATURES=false

# ==============================================
# Performance Tuning
# ==============================================
# Database pool size (maximum number of persistent connections)
# PERFORMANCE IMPACT:
#   - Higher values (20-50): Better concurrency, higher memory usage (~5-10MB per connection)
#   - Lower values (5-10): Lower memory, may cause connection wait under load
#   - Formula: DB_POOL_SIZE >= number_of_workers * concurrent_requests_per_worker
#   - Each connection consumes PostgreSQL backend process memory
# RECOMMENDATION: Start with 20, monitor with SHOW STATISTICS; increase if seeing "connection pool exhausted"
# See docs/ENVIRONMENT_VARIABLES.md#performance for more details
DB_POOL_SIZE=20

# Maximum additional connections beyond pool size during peak load
# PERFORMANCE IMPACT:
#   - Allows temporary scaling beyond DB_POOL_SIZE (e.g., 20 + 10 = 30 max connections)
#   - Overflow connections are created on-demand and closed after use
#   - Higher values = better burst handling, more PostgreSQL connection overhead
# RECOMMENDATION: Set to 50% of DB_POOL_SIZE (e.g., 10 for pool of 20)
# See docs/ENVIRONMENT_VARIABLES.md#performance for more details
DB_MAX_OVERFLOW=10

# Database pool recycle time (seconds) - closes and recreates connections periodically
# PERFORMANCE IMPACT:
#   - Prevents stale connections and PostgreSQL connection limits
#   - Lower values (300-1800): More connection churn, slightly higher overhead
#   - Higher values (3600+): Less churn, but risk of stale connections
#   - Set to < PostgreSQL's idle_timeout to avoid disconnections
# RECOMMENDATION: 3600 (1 hour) for most cases; reduce to 1800 if seeing "server closed the connection unexpectedly"
# See docs/ENVIRONMENT_VARIABLES.md#performance for more details
DB_POOL_RECYCLE=3600

# Connection pool timeout (seconds) - max time to wait for available connection
# PERFORMANCE IMPACT:
#   - Lower values (5-15): Fail fast under load, returns errors to clients quickly
#   - Higher values (30-60): Better tolerance for traffic spikes, longer wait times
#   - If consistently hitting timeout, increase DB_POOL_SIZE or scale workers
# RECOMMENDATION: 30 seconds; monitor timeouts with application metrics
# See docs/ENVIRONMENT_VARIABLES.md#performance for more details
DB_POOL_TIMEOUT=30

# ==============================================
# Localization
# ==============================================
# Default language: en, ru
DEFAULT_LANGUAGE=en

# Supported languages (comma-separated)
SUPPORTED_LANGUAGES=en,ru

# ==============================================
# File Cleanup Configuration
# ==============================================
# Enable automatic cleanup of uploaded files
ENABLE_FILE_CLEANUP=true

# File cleanup interval (hours)
FILE_CLEANUP_INTERVAL_HOURS=24

# File retention period (hours)
FILE_RETENTION_HOURS=48

# ==============================================
# Email Configuration (Optional)
# ==============================================
# ⚠️ SECURITY: SMTP credentials for sending emails
# PRODUCTION: Use app-specific passwords or OAuth2 instead of regular passwords
# PRODUCTION: For Gmail, use an App Password: https://myaccount.google.com/apppasswords
# PRODUCTION: Consider using transactional email services (SendGrid, AWS SES) in production
# PRODUCTION: Enable SPF, DKIM, and DMARC for better deliverability and security
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@resume-analysis.com
SMTP_TLS=true

# ==============================================
# Webhook Configuration (Optional)
# ==============================================
# ⚠️ SECURITY: Webhook configuration for analysis completion notifications
# PRODUCTION: Always use HTTPS endpoints (http:// is insecure)
# PRODUCTION: Generate a strong random secret (openssl rand -hex 32)
# PRODUCTION: Verify webhook signatures on your endpoint to prevent request forgery
# WEBHOOK_URL=https://your-webhook-endpoint.com/notify
# WEBHOOK_SECRET=your-webhook-secret

# ==============================================
# Backup Configuration
# ==============================================
# Enable automatic database backups
ENABLE_AUTO_BACKUP=false

# Backup interval (hours)
BACKUP_INTERVAL_HOURS=24

# Backup retention (days)
BACKUP_RETENTION_DAYS=30

# ==============================================
# Security Best Practices & Notes
# ==============================================
# ⚠️ CRITICAL SECURITY REMINDERS:
# 1. NEVER commit .env file to version control (add .env to .gitignore)
# 2. Use strong, unique passwords (minimum 16 characters, mixed case, numbers, symbols)
# 3. Rotate API keys and secrets regularly (recommend every 90 days)
# 4. Use different credentials for development, staging, and production
# 5. Test all configuration values before deploying to production
# 6. Use environment-specific secrets management in production (AWS Secrets Manager, HashiCorp Vault, etc.)
# 7. Implement secrets scanning in your CI/CD pipeline (e.g., git-secrets, truffleHog)
# 8. Monitor for leaked secrets and rotate immediately if compromised
# 9. Use read-only credentials where possible (principle of least privilege)
# 10. Enable audit logging for all credential usage in production
