# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/resume_analysis
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=resume_analysis

# Redis Configuration (for Celery)
REDIS_URL=redis://localhost:6379/0
REDIS_HOST=redis
REDIS_PORT=6379

# Backend Configuration
BACKEND_PORT=8000
BACKEND_HOST=0.0.0.0

# Frontend Configuration
FRONTEND_PORT=5173
FRONTEND_HOST=0.0.0.0

# ML Models Configuration
MODELS_CACHE_PATH=./models_cache

# LanguageTool Server (for grammar/spelling checking)
LANGUAGETOOL_SERVER=http://localhost:8081/v2/check

# Celery Configuration
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# API Keys (Optional - for LLM-based features)
# OPENAI_API_KEY=your_key_here
# ANTHROPIC_API_KEY=your_key_here

# Neo4j Graph Database Configuration (for Graphiti-Core)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=graphiti_password

# Graphiti Configuration
GRAPHITI_TELEMETRY_ENABLED=false
SEMAPHORE_LIMIT=10

# Application Settings
MAX_UPLOAD_SIZE_MB=10
ALLOWED_FILE_TYPES=.pdf,.docx
ANALYSIS_TIMEOUT_SECONDS=300

# CORS Settings
FRONTEND_URL=http://localhost:5173

# Session Management
SESSION_IDLE_TIMEOUT_MINUTES=30

# Login Protection Configuration
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_DURATION_MINUTES=15
LOGIN_LOCKOUT_ENABLED=true

# OAuth 2.0 Configuration
OAUTH_ENABLED=true
OAUTH_SESSION_LIFETIME_SECONDS=3600

# Google OAuth 2.0 Configuration
# Get credentials from: https://console.cloud.google.com/apis/credentials
OAUTH_GOOGLE_CLIENT_ID=
OAUTH_GOOGLE_CLIENT_SECRET=
OAUTH_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/google/callback

# Microsoft OAuth 2.0 Configuration
# Get credentials from: https://portal.azure.com/#view/Microsoft_AAD_RegisteredApps
OAUTH_MICROSOFT_CLIENT_ID=
OAUTH_MICROSOFT_CLIENT_SECRET=
OAUTH_MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/microsoft/callback
OAUTH_MICROSOFT_TENANT=common

# GitHub OAuth 2.0 Configuration
# Get credentials from: https://github.com/settings/developers
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_CLIENT_SECRET=
OAUTH_GITHUB_REDIRECT_URI=http://localhost:8000/api/v1/auth/oauth/github/callback

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Backup Configuration
BACKUP_ENABLED=true
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *

# S3 Backup Configuration (Optional)
BACKUP_S3_ENABLED=false
BACKUP_S3_BUCKET=
BACKUP_S3_ENDPOINT=
BACKUP_S3_ACCESS_KEY=
BACKUP_S3_SECRET_KEY=
BACKUP_S3_REGION=us-east-1

# Backup Notifications
BACKUP_NOTIFICATION_EMAIL=

# Grafana Configuration
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# Grafana SMTP Configuration (for email alerts)
# Common SMTP servers:
# - Gmail: smtp.gmail.com:587
# - Outlook: smtp.office365.com:587
# - SendGrid: smtp.sendgrid.net:587
# - Mailgun: smtp.mailgun.org:587
GRAFANA_SMTP_HOST=smtp.gmail.com:587
GRAFANA_SMTP_USER=your_email@gmail.com
GRAFANA_SMTP_PASSWORD=your_app_password
GRAFANA_SMTP_FROM_ADDRESS=grafana@yourdomain.com
GRAFANA_SMTP_STARTTLS_POLICY=OpportunisticStartTLS

# Alert Notification Channels
# Email address to receive alerts
ALERT_ENABLED=true
ALERT_EMAIL_ADDRESS=alerts@example.com

# Webhook URL for alerts (e.g., Slack, Microsoft Teams, Discord)
# Slack: https://hooks.slack.com/services/YOUR/WEBHOOK/URL
# Microsoft Teams: https://outlook.office.com/webhook/YOUR_WEBHOOK_URL
# Discord: https://discord.com/api/webhooks/YOUR_WEBHOOK_URL
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_USERNAME=
ALERT_WEBHOOK_PASSWORD=
ALERT_WEBHOOK_BEARER_TOKEN=

# Health Check Alert Configuration
HEALTH_CHECK_ALERT_ENABLED=true
HEALTH_CHECK_ALERT_EMAIL=alerts@example.com
HEALTH_CHECK_ALERT_ON_WARNING=true
HEALTH_CHECK_ALERT_ON_CRITICAL=true
HEALTH_CHECK_ALERT_COOLDOWN_MINUTES=30
