# ==============================================
# Backend Development Environment Variables Template
# ==============================================
# Copy this file to .env.dev and update with your values
# This template is for the development environment

# ==============================================
# Environment Configuration
# ==============================================
# Current environment: development, staging, production
ENVIRONMENT=development

# ==============================================
# Database Configuration
# ==============================================
# PostgreSQL database connection URL
# Format: postgresql://user:password@host:port/database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analysis

# ==============================================
# Redis Configuration
# ==============================================
# Redis connection URL for caching and Celery
REDIS_URL=redis://localhost:6379/0

# ==============================================
# Backend Server Configuration
# ==============================================
# Host to bind the FastAPI server
BACKEND_HOST=127.0.0.1

# Port to bind the FastAPI server
BACKEND_PORT=8000

# ==============================================
# Frontend Configuration (CORS)
# ==============================================
# Frontend URL for CORS configuration
FRONTEND_URL=http://localhost:5173

# ==============================================
# ML Models Configuration
# ==============================================
# Path to cache ML models (relative or absolute)
MODELS_CACHE_PATH=./models_cache

# ==============================================
# LanguageTool Server Configuration
# ==============================================
# LanguageTool server URL for grammar checking (optional)
# Leave empty to disable grammar checking
LANGUAGETOOL_SERVER=

# ==============================================
# File Upload Configuration
# ==============================================
# Maximum file upload size in megabytes (1-100)
MAX_UPLOAD_SIZE_MB=20

# Allowed file extensions for upload (comma-separated)
ALLOWED_FILE_TYPES=.pdf,.docx

# ==============================================
# Analysis Configuration
# ==============================================
# Maximum time for resume analysis in seconds (30-600)
ANALYSIS_TIMEOUT_SECONDS=600

# ==============================================
# Logging Configuration
# ==============================================
# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=DEBUG

# ==============================================
# Celery Configuration
# ==============================================
# Celery broker URL (typically same as Redis URL)
CELERY_BROKER_URL=redis://localhost:6379/0

# Celery result backend URL (typically same as Redis URL)
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================
# Backup Configuration
# ==============================================
# Enable automated backups
BACKUP_ENABLED=false

# Default backup retention period in days (1-365)
BACKUP_RETENTION_DAYS=30

# Cron expression for scheduled backups (default: daily at 2 AM)
BACKUP_SCHEDULE=0 2 * * *

# Directory for storing backup files
BACKUP_DIR=./data/backups

# Enable S3 off-site backup
BACKUP_S3_ENABLED=false

# S3 bucket name for backups
# BACKUP_S3_BUCKET=

# S3-compatible endpoint URL
# BACKUP_S3_ENDPOINT=

# S3 access key ID
# BACKUP_S3_ACCESS_KEY=

# S3 secret access key
# BACKUP_S3_SECRET_KEY=

# S3 region
BACKUP_S3_REGION=us-east-1

# Email for backup failure notifications
# BACKUP_NOTIFICATION_EMAIL=

# Enable incremental backups
BACKUP_INCREMENTAL_ENABLED=true

# Enable backup compression
BACKUP_COMPRESSION_ENABLED=true

# ==============================================
# Audit Log Configuration
# ==============================================
# Default audit log retention period in days (1-365)
AUDIT_LOG_RETENTION_DAYS=90

# ==============================================
# LLM API Configuration for ATS Simulation
# ==============================================
# LLM provider: openai, anthropic, google, zai
LLM_PROVIDER=zai

# Z.ai API key for ATS simulation
# ZAI_API_KEY=your-zai-api-key-here

# Z.ai API base URL
ZAI_BASE_URL=https://api.z.ai/api/paas/v4

# OpenAI API key (if using OpenAI as provider)
# OPENAI_API_KEY=your-openai-api-key-here

# Anthropic API key (if using Anthropic as provider)
# ANTHROPIC_API_KEY=your-anthropic-api-key-here

# Google API key (if using Google as provider)
# GOOGLE_API_KEY=your-google-api-key-here

# Default LLM model for ATS simulation
LLM_MODEL=glm-4.7

# Temperature for LLM calls (0.0-1.0, lower = more deterministic)
LLM_TEMPERATURE=0.1

# Maximum tokens for LLM responses (256-32768)
LLM_MAX_TOKENS=4096

# ==============================================
# ATS Simulation Configuration
# ==============================================
# Minimum ATS score to pass (0.0-1.0)
ATS_THRESHOLD=0.6

# Enable visual format checking in ATS
ATS_VISUAL_CHECK_ENABLED=true

# Weight for keyword matching in ATS score (0.0-1.0)
ATS_KEYWORD_WEIGHT=0.3

# Weight for experience matching in ATS score (0.0-1.0)
ATS_EXPERIENCE_WEIGHT=0.3

# Weight for education matching in ATS score (0.0-1.0)
ATS_EDUCATION_WEIGHT=0.2

# Weight for overall fit assessment in ATS score (0.0-1.0)
ATS_FIT_WEIGHT=0.2

# ==============================================
# Notes
# ==============================================
# 1. Copy this file to .env.dev and update with your actual values
# 2. Never commit .env.dev to version control (it contains sensitive data)
# 3. Only commit .env.dev.example as a template
# 4. Changes to .env.dev require restarting the backend server
# 5. All optional values can be left empty or commented out
# 6. Test all configuration values before deploying
