# ==============================================
# Backend Development Environment Variables
# ==============================================
# This file contains actual configuration for the development environment
# DO NOT commit this file to version control

# ==============================================
# Environment Configuration
# ==============================================
ENVIRONMENT=development

# ==============================================
# Database Configuration
# ==============================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/resume_analysis

# ==============================================
# Redis Configuration
# ==============================================
REDIS_URL=redis://localhost:6379/0

# ==============================================
# Backend Server Configuration
# ==============================================
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# ==============================================
# Frontend Configuration (CORS)
# ==============================================
FRONTEND_URL=http://localhost:5173

# ==============================================
# ML Models Configuration
# ==============================================
MODELS_CACHE_PATH=./models_cache

# ==============================================
# LanguageTool Server Configuration
# ==============================================
# LANGUAGETOOL_SERVER=

# ==============================================
# File Upload Configuration
# ==============================================
MAX_UPLOAD_SIZE_MB=20
ALLOWED_FILE_TYPES=.pdf,.docx

# ==============================================
# Analysis Configuration
# ==============================================
ANALYSIS_TIMEOUT_SECONDS=600

# ==============================================
# Logging Configuration
# ==============================================
LOG_LEVEL=DEBUG

# ==============================================
# Celery Configuration
# ==============================================
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# ==============================================
# Backup Configuration
# ==============================================
BACKUP_ENABLED=false
BACKUP_RETENTION_DAYS=30
BACKUP_SCHEDULE=0 2 * * *
BACKUP_DIR=./data/backups
BACKUP_S3_ENABLED=false
BACKUP_S3_REGION=us-east-1
BACKUP_INCREMENTAL_ENABLED=true
BACKUP_COMPRESSION_ENABLED=true

# ==============================================
# Audit Log Configuration
# ==============================================
AUDIT_LOG_RETENTION_DAYS=90

# ==============================================
# LLM API Configuration for ATS Simulation
# ==============================================
LLM_PROVIDER=zai
# ZAI_API_KEY=
ZAI_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.7
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=4096

# ==============================================
# ATS Simulation Configuration
# ==============================================
ATS_THRESHOLD=0.6
ATS_VISUAL_CHECK_ENABLED=true
ATS_KEYWORD_WEIGHT=0.3
ATS_EXPERIENCE_WEIGHT=0.3
ATS_EDUCATION_WEIGHT=0.2
ATS_FIT_WEIGHT=0.2
